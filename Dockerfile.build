# Compiles Nori inside Docker, then serves it with nginx. Needs no local Flutter.
#   docker build -f Dockerfile.build -t nori .
#   docker run --rm -p 8080:80 nori     ->  http://localhost:8080
# UNTESTED: the first build downloads the ~1.3 GB Flutter image, which was too
# slow to finish on the connection it was written on.
FROM ghcr.io/cirruslabs/flutter:3.38.6 AS build
WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY . .
RUN flutter build web --release

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
EXPOSE 80
