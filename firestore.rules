rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- /users/{uid} -------------------------------------------------
    // Every collection below lives under this doc. Firestore rules do NOT
    // cascade from a parent match to its subcollections — each match block
    // below is independently responsible for its own auth check.
    match /users/{uid} {
      allow read: if request.auth.uid == uid;

      // Progression fields (level/XP/coins) are Cloud-Function-only — only
      // reachable via the Admin SDK inside claimHabit etc., which bypasses
      // rules entirely. Client writes may only touch profile + vacation
      // fields. See docs/BACKEND.md:296-299.
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'name', 'username', 'email', 'avatarUrl',
               'vacationModeEnabled', 'vacationRanges', 'habitCategories',
             ]);

      // --- /users/{uid}/habits/{habitId} -------------------------------
      match /habits/{habitId} {
        allow read: if request.auth.uid == uid; //Allow this data to be read only if the logged-in person’s UID matches the UID in the data’s path

        // A habit doc is purely a definition — currentValue/isCompletedToday/
        // lastAwardedXp/lastAwardedCoins live in habitLogs instead, for
        // every day including today (2026-09-24: fixed the midnight-
        // rollover bug logged in docs/KNOWN_ISSUES.md by moving "today" out
        // of the habit doc entirely — see FirestoreHabitRepository). So
        // there's no Cloud-Function-only field left on this doc to guard.
        allow create: if request.auth.uid == uid;

        // order (drag-reorder) and archived (future delete-as-archive) are
        // legitimately client-writable, just not via editing a habit's own
        // definition — FirestoreHabitRepository.updateHabit deliberately
        // excludes them (reorderHabits/a future archive flow write them
        // directly instead). createdAt is set once at creation and never
        // touched by an edit.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'name', 'subtitle', 'iconKey', 'colorKey',
                 'xpReward', 'coinReward', 'repeat', 'type', 'difficulty',
                 'targetValue', 'unit', 'minThreshold', 'quickLogAmount',
                 'adaptiveMultiplier', 'customDays',
                 'allowVacationFreeze', 'startDate', 'endDate', 'order',
                 'archived',
               ]);

        // Deleting a habit archives it (sets archived = true via the
        // update rule above) instead of removing the doc — habitLogs must
        // survive for history/streaks. See docs/BACKEND.md:64.
        allow delete: if false;
      }

      // --- /users/{uid}/habitLogs/{logId} ------------------------------
      // logId is '{dayKey}_{habitId}', e.g. '2026-09-21_abc123' — flat
      // collection, not nested under habits/, so calendar views can range-
      // query by date across every habit in one query. See
      // docs/BACKEND.md:129-134.
      match /habitLogs/{logId} {
        allow read: if request.auth.uid == uid;

        allow create: if request.auth.uid == uid
          && request.resource.data.claimed == false
          && request.resource.data.awardedXp == 0
          && request.resource.data.awardedCoins == 0;

        // Logging progress during the day (quick-log amount, manual entry)
        // may only touch `value` — claiming/unclaiming XP payout is
        // Cloud-Function-only. See docs/BACKEND.md:300-302.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['value']);

        allow delete: if false;
      }

      // TODO(Jimena): pet/main, inventory/main — field-level rules
      // sketched at docs/BACKEND.md:303-328, not written yet.
    }

    // TODO(Jimena): /usernames/{usernameLower} — global index collection,
    // sketched at docs/BACKEND.md:329-332, not written yet.

    // Anything not explicitly matched above stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
