rules_version = '2';

// Nori — Firestore security rules for the live nori-pet project.
// Mirror any rules published from the console here.
service cloud.firestore {
  // Inventory care counts may decrease only, and never below zero; purchaseCareItem alone
  // grants more items. A bare "<= old" would let a client write -5 over 3.
  function careItemCountsOnlyDecreased(oldCounts, newCounts) {
    return newCounts.keys().hasOnly(oldCounts.keys())
      && newCounts.food >= 0 && newCounts.food <= oldCounts.food
      && newCounts.cake >= 0 && newCounts.cake <= oldCounts.cake
      && newCounts.shampoo >= 0 && newCounts.shampoo <= oldCounts.shampoo
      && newCounts['hair-brush'] >= 0 && newCounts['hair-brush'] <= oldCounts['hair-brush']
      && newCounts.plushie >= 0 && newCounts.plushie <= oldCounts.plushie
      && newCounts.blanket >= 0 && newCounts.blanket <= oldCounts.blanket;
  }

  match /databases/{database}/documents {

    // /users/{uid}: user profile and progression.
    // Parent rules do not cover subcollections; each match needs its own auth check.
    match /users/{uid} {
      allow read: if request.auth.uid == uid;

      // Level/XP/coins are Cloud-Function-only to prevent clients granting themselves currency.
      // Clients may edit profile, vacation and habit category fields.
      allow update: if request.auth.uid == uid
        && resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'name', 'username', 'email', 'avatarUrl',
               'vacationModeEnabled', 'vacationRanges', 'habitCategories',
             ]);

      // /users/{uid}/habits/{habitId}
      match /habits/{habitId} {
        allow read: if request.auth.uid == uid; //Allow this data to be read only if the logged-in person’s UID matches the UID in the data’s path

        // Habit docs hold definitions only; daily progress, completion and payouts live in habitLogs.
        allow create: if request.auth.uid == uid;

        // Clients may edit definitions, reorder, archive and restore habits.
        // createdAt is fixed at creation.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'name', 'subtitle', 'iconKey', 'colorKey',
                 'xpReward', 'coinReward', 'repeat', 'type', 'difficulty',
                 'targetValue', 'unit', 'minThreshold', 'quickLogAmount',
                 'adaptiveMultiplier', 'customDays',
                 'allowVacationFreeze', 'startDate', 'endDate', 'order',
                 'archived', 'archivedRanges',
               ]);

        // Archive habits with history; deleteHabit alone deletes those with almost no history
        // and reverses their payouts atomically.
        allow delete: if false;
      }

      // /users/{uid}/habitLogs/{logId}: daily progress and claims, keyed by {dayKey}_{habitId}.
      // Flat storage lets calendar queries span all habits by date.
      match /habitLogs/{logId} {
        allow read: if request.auth.uid == uid;

        allow create: if request.auth.uid == uid
          && request.resource.data.claimed == false
          && request.resource.data.awardedXp == 0
          && request.resource.data.awardedCoins == 0;

        // Logging progress during the day (quick-log amount, manual entry)
        // may only touch `value` — claiming/unclaiming XP payout is
        // Cloud-Function-only. See docs/BACKEND.md:300-302.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['value']);

        allow delete: if false;
      }

      // /users/{uid}/pet/main
      match /pet/main {
        allow read: if request.auth.uid == uid;

        // stage/evolutionLevelThreshold are Cloud-Function-only to prevent client-set evolution.
        // Clients may edit pet name, stats and decay fields.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'hunger', 'hygiene', 'happiness', 'lastDecayAt']);

        // Created only by onUserCreate (Admin SDK, bypasses these rules).
        allow create: if false;
        allow delete: if false;
      }

      // /users/{uid}/inventory/main: owned care items and accessories.
      // Only purchaseCareItem, purchaseAccessory and the claimHabit gift may grant items;
      // clients may consume/remove items and equip only accessories already owned.
      match /inventory/main {
        allow read: if request.auth.uid == uid;

        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['careItemCounts', 'ownedAccessoryIds', 'equippedAccessoryId'])
          && careItemCountsOnlyDecreased(
               resource.data.careItemCounts,
               request.resource.data.careItemCounts
             )
          && request.resource.data.ownedAccessoryIds.hasOnly(resource.data.ownedAccessoryIds)
          && (request.resource.data.equippedAccessoryId == null
              || resource.data.ownedAccessoryIds.hasAny([request.resource.data.equippedAccessoryId]));

        // Created only by onUserCreate (Admin SDK, bypasses these rules).
        allow create: if false;
        allow delete: if false;
      }

      // /users/{uid}/bucketList/{itemId}
      match /bucketList/{itemId} {
        allow read: if request.auth.uid == uid;

        // New item: the Cloud-Function-only fields must start at their
        // untouched defaults -- mirrors the habit doc's create rule
        // above.
        allow create: if request.auth.uid == uid
          && request.resource.data.isCompleted == false
          && request.resource.data.awardedXp == 0
          && request.resource.data.awardedCoins == 0;

        // isCompleted/completedAt/awardedXp/awardedCoins are Cloud-Function-only:
        // completeBucketListItem/uncompleteBucketListItem control completion and payouts.
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'title', 'description', 'iconKey', 'colorKey',
                 'xpReward', 'coinReward',
               ]);

        // Direct deletion is allowed only for incomplete items that never paid a reward.
        // Uncompletion keeps payouts; deleteBucketListItem reverses them atomically.
        allow delete: if request.auth.uid == uid
          && resource.data.isCompleted != true
          && resource.data.get('awardedXp', 0) == 0
          && resource.data.get('awardedCoins', 0) == 0;
      }

      // /users/{uid}/notifications/{notificationId}: in-app feed.
      // Clients compute achievement/streak events; Cloud Functions write all other kinds.
      // Client events start unread with a server timestamp and may only be marked read.
      match /notifications/{notificationId} {
        allow read: if request.auth.uid == uid;

        allow create: if request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['kind', 'message', 'createdAt', 'isRead'])
          && request.resource.data.kind in ['achievement', 'streak']
          && request.resource.data.message is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false;

        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['isRead']);

        allow delete: if false;
      }

      // /users/{uid}/notificationState/main: notification deduplication state.
      // level/petEvolved/petCareAt are Cloud-Function-only to prevent client-triggered repeats.
      match /notificationState/main {
        allow read: if request.auth.uid == uid;

        allow create: if request.auth.uid == uid
          && request.resource.data.keys()
               .hasOnly(['achievementIds', 'streakMilestone', 'streakMilestoneDay']);

        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['achievementIds', 'streakMilestone', 'streakMilestoneDay']);

        allow delete: if false;
      }
    }

    // /usernames/{usernameLower}: global, case-insensitive username ownership index.
    // Public reads support availability checks before sign-up; atomic creates enforce uniqueness.
    // Owners may delete entries to change usernames; updates are denied.
    match /usernames/{usernameLower} {
      allow read: if true;
      // The id is the lowercased handle: 3-20 letters, digits or underscores (same as the app).
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.uid
                    && usernameLower.matches('[a-z0-9_]{3,20}')
                    && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
                    && request.resource.data.username is string
                    && request.resource.data.username.lower() == usernameLower;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;
      allow update: if false;
    }

    // Anything not explicitly matched above stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
